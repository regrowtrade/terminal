# The engine does not load this file. Inject variables in the process/provider.
ENGINE_API_TOKEN=replace-with-the-same-private-token-as-the-web
ENGINE_ADDRESS=127.0.0.1:8080
DATABASE_REQUIRED=false
# For Railway: true, with a limited application role, never postgres/admin.
# DATABASE_URL=postgresql://<application-role>:<unique-password>@<private-host>:5432/<database>?sslmode=disable
# MIGRATIONS_DIR=../../database/migrations
# MIGRATION_DATABASE_URL belongs ONLY to the separate administrative job.
